{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/website-bookings run build",
  "outputDirectory": "artifacts/website-bookings/dist/public",
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/sign-in/:path*", "destination": "/index.html" },
    { "source": "/sign-up", "destination": "/index.html" },
    { "source": "/sign-up/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/[...path].ts": { "maxDuration": 30 }
  }
}
